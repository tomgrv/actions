{
    "name": "@tomgrv/actions",
    "version": "1.1.0",
    "description": "Composite GitHub Actions for monorepo split, PR validation and PHP setup",
    "keywords": [
        "github-actions",
        "actions",
        "monorepo",
        "flekskit"
    ],
    "homepage": "https://github.com/tomgrv/actions#readme",
    "bugs": {
        "url": "https://github.com/tomgrv/actions/issues"
    },
    "license": "MIT",
    "author": "Thomas G. <1809566+tomgrv@users.noreply.github.com>",
    "files": [
        "dispatch.sh",
        "setup-php/*",
        "config-bot/*",
        "degit-package/*",
        "create-pr/*",
        "split-package/*",
        "check-composer/*",
        "check-pr-format/*",
        "run-phpmd/*",
        "run-phpinsights/*",
        "run-filacheck/*",
        "run-phpstan/*",
        "run-phptests/*",
        "run-pint/*",
        "check-secret/*",
        "check-security-composer/*",
        "check-security-npm/*",
        "update-labels/*",
        "detect-changes/*",
        "list-packages/*",
        "rebase-pr/*",
        "setup-node/*"
    ],
    "bin": {
        "actions": "./dispatch.sh"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tomgrv/actions"
    },
    "scripts": {
        "lint": "npx --yes lint-staged",
        "release": "npx --yes commit-and-tag-version --no-verify --",
        "test": "echo \"Error: no test specified\" && exit 1",
        "update": "npx --yes npm-check-updates -i -u",
        "update-all": "npm run update -w --root"
    },
    "config": {
        "commitizen": {
            "path": "@commitlint/cz-commitlint"
        }
    },
    "devDependencies": {
        "npm-check-updates": "*"
    },
    "peerDependencies": {
        "@commitlint/cli": "*",
        "@commitlint/config-conventional": "*",
        "@commitlint/core": "*",
        "@commitlint/cz-commitlint": "*",
        "commitizen": "*",
        "git-precommit-checks": "*",
        "prettier": "*",
        "prettier-plugin-sh": "*"
    },
    "private": true,
    "workspaces": [
        "check-composer",
        "check-pr-format",
        "check-secret",
        "check-security-composer",
        "check-security-npm",
        "config-bot",
        "create-pr",
        "degit-package",
        "detect-changes",
        "list-packages",
        "rebase-pr",
        "run-phpinsights",
        "run-filacheck",
        "run-phpmd",
        "run-phpstan",
        "run-phptests",
        "run-pint",
        "setup-node",
        "setup-php",
        "split-package",
        "update-labels"
    ],
    "prettier": {
        "insertPragma": true,
        "overrides": [
            {
                "files": "*.json",
                "options": {
                    "tabWidth": 4,
                    "useTabs": false
                }
            },
            {
                "files": "*.yml",
                "options": {
                    "tabWidth": 2,
                    "useTabs": false
                }
            },
            {
                "files": "*.yml",
                "options": {
                    "tabWidth": 2,
                    "useTabs": true
                }
            }
        ],
        "plugins": [
            "prettier-plugin-sh"
        ],
        "semi": false,
        "singleQuote": true,
        "tabWidth": 4,
        "trailingComma": "es5"
    },
    "bump-changelog": {
        "types": [
            {
                "type": "feat",
                "section": "Features"
            },
            {
                "type": "fix",
                "section": "Bug Fixes"
            }
        ]
    },
    "bump-version": {
        "files": [
            {
                "filename": "composer.json",
                "type": "json"
            },
            {
                "filename": "package.json",
                "type": "json"
            },
            {
                "filename": "package.json",
                "type": "json@ws"
            },
            {
                "filename": "devcontainer-feature.json",
                "type": "json@ws"
            },
            {
                "filename": "VERSION",
                "type": "plain-text"
            }
        ]
    },
    "commit-and-tag-version": {
        "scripts": {
            "prebump": "gitversion -config .gitversion -showvariable SemVer"
        }
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional",
            "@commitlint/config-workspace-scopes"
        ],
        "rules": {
            "subject-case": [
                2,
                "never",
                [
                    "start-case",
                    "pascal-case",
                    "upper-case"
                ]
            ]
        }
    },
    "git-precommit-checks": {
        "rules": [
            {
                "filter": "(^package\\.json|\\.git-precommit-checks.json)$",
                "message": "You have unfinished devs",
                "nonBlocking": "true",
                "regex": "(?:FIXME|TODO)"
            },
            {
                "message": "You've got leftover conflict markers",
                "regex": "/^[<>|=]{4,}/m"
            }
        ]
    },
    "lint-staged": {
        "!(*schema).json": [
            "normalize-json -c -w -a -i -t 4 -f local -l true"
        ],
        "!(templates/**/*)*.{js,jsx,ts,tsx,md,html,css,vue,yaml,yml}": [
            "npx --yes prettier --write"
        ],
        "!(templates/**/*).{js,jsx,ts,tsx,md,html,css,vue,yaml,yml,json}": [
            "npx --yes prettier --write"
        ],
        "*.json": [
            "normalize-json -c -w -a -i -f local -l true",
            "npx --yes prettier --write"
        ],
        "*.php": [
            "composer lint"
        ]
    },
    "validate-branch-name": {
        "errorMsg": "Cannot push to a branch that does not follow the naming convention.",
        "pattern": "^(master|main|develop){1}$|^(copilot|feature|fix|hotfix|release)/.+$"
    }
}
