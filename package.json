{
    "name": "@tomgrv/actions",
    "version": "1.0.1",
    "description": "Composite GitHub Actions for monorepo split, PR validation and PHP setup",
    "keywords": [
        "github-actions",
        "actions",
        "monorepo",
        "flekskit"
    ],
    "homepage": "https://github.com/tomgrv/actions#readme",
    "bugs": {
        "url": "https://github.com/tomgrv/actions/issues"
    },
    "license": "MIT",
    "author": "Thomas G. <1809566+tomgrv@users.noreply.github.com>",
    "files": [
        "setup-php",
        "config-bot",
        "degit-package",
        "create-pr",
        "split-package",
        "check-composer",
        "check-pr-format",
        "run-phpmd",
        "run-phpinsights",
        "run-phpstan",
        "run-phptests",
        "run-pint",
        "check-secret",
        "check-security-composer",
        "check-security-npm",
        "update-labels"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/tomgrv/actions"
    },
    "scripts": {
        "lint": "npx --yes lint-staged",
        "release": "npx --yes commit-and-tag-version --no-verify --",
        "test": "echo \"Error: no test specified\" && exit 1",
        "update": "npx --yes npm-check-updates -i -u"
    },
    "config": {
        "commitizen": {
            "path": "@commitlint/cz-commitlint"
        }
    },
    "prettier": {
        "insertPragma": true,
        "overrides": [
            {
                "files": "*.yml",
                "options": {
                    "useTabs": true,
                    "tabWidth": 2
                }
            }
        ],
        "plugins": [
            "prettier-plugin-sh"
        ],
        "semi": false,
        "singleQuote": true,
        "tabWidth": 4,
        "trailingComma": "es5"
    },
    "commit-and-tag-version": {
        "bumpFiles": [
            {
                "filename": "composer.json",
                "type": "json"
            },
            {
                "filename": "package.json",
                "type": "json"
            },
            {
                "filename": "VERSION",
                "type": "plain-text"
            }
        ],
        "types": [
            {
                "section": "Features",
                "type": "feat"
            },
            {
                "section": "Bug Fixes",
                "type": "fix"
            },
            {
                "hidden": true,
                "type": "chore"
            },
            {
                "hidden": true,
                "type": "docs"
            },
            {
                "hidden": true,
                "type": "style"
            },
            {
                "hidden": true,
                "type": "refactor"
            },
            {
                "hidden": true,
                "type": "perf"
            },
            {
                "hidden": true,
                "type": "test"
            }
        ]
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional",
            "@commitlint/config-workspace-scopes"
        ],
        "rules": {
            "subject-case": [
                2,
                "never",
                [
                    "start-case",
                    "pascal-case",
                    "upper-case"
                ]
            ]
        }
    },
    "git-precommit-checks": {
        "rules": [
            {
                "message": "You've got leftover conflict markers",
                "regex": "/^[<>|=]{4,}/m"
            },
            {
                "filter": "(^package\\.json|\\.git-precommit-checks.json)$",
                "message": "You have unfinished devs",
                "nonBlocking": "true",
                "regex": "(?:FIXME|TODO)"
            }
        ]
    },
    "lint-staged": {
        "!(templates/**/*)*.{js,jsx,ts,tsx,md,html,css,vue,yaml,yml}": [
            "npx --yes prettier --write"
        ],
        "*.json": [
            "normalize-json -c -w -a -i -f local -l true",
            "npx --yes prettier --write"
        ],
        "*.php": [
            "composer lint"
        ]
    }
}
